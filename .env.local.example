# Exemplo das env vars do projeto. Copie para .env.local e preencha.
# .env.local NAO entra no git.

# ============ Supabase ============
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============ SEO publico ============

# PostHog EU cloud (prompt 05) — analytics SEO
# Criar projeto em https://eu.posthog.com (free tier serve)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Microsoft Clarity (opcional, prompt 05)
# https://clarity.microsoft.com
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Google Search Console (prompt 06)
# Token gerado em https://search.google.com/search-console
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bing Webmaster Tools (prompt 06)
# Token gerado em https://www.bing.com/webmasters
# BING_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# IndexNow key (prompt 06, opcional)
# https://www.bing.com/indexnow gera a key. Tambem precisa criar
# public/[KEY].txt com a key como conteudo (validacao de propriedade).
# NEXT_PUBLIC_INDEXNOW_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

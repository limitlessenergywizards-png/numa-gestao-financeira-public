{
  "nodes": [
    {
      "parameters": {
        "toolDescription": "Busca fornecedores pelo nome. Use para verificar se o fornecedor já existe. ARGUMENTOS: name (string).",
        "tableId": "suppliers",
        "operation": "getAll",
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "fieldId": "company_id",
              "operator": "eq",
              "value": "={{ $('Lead CRUD (Supabase)').item.json.company_id }}"
            },
            {
              "fieldId": "name",
              "operator": "ilike",
              "value": "={{ $json.name || $json.nome }}"
            },
            {
              "fieldId": "is_active",
              "operator": "eq",
              "value": "true"
            }
          ]
        },
        "limit": 5
      },
      "id": "injected-supabase-buscar_fornecedor",
      "name": "buscar_fornecedor",
      "type": "n8n-nodes-base.supabaseTool",
